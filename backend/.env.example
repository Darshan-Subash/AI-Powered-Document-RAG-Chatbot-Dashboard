# Copy this file to .env and fill in the values you need.
# Never commit the real .env file.

# ---------- Supabase Postgres (metadata + pgvector embeddings) ----------
# Supabase dashboard -> Project Settings -> Database -> Connection string
# (URI format). Use the pooled "Transaction" or "Session" connection string
# if your host recommends it; the direct one works fine for a normal
# always-on server like Render/Railway/a VPS.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ---------- Supabase Storage (uploaded files) ----------
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Create this bucket once in Supabase -> Storage (any name, private is fine)
SUPABASE_BUCKET=documents

# ---------- Embeddings ----------
# local        = sentence-transformers, free, runs on your machine/server (384 dims, default)
# openai       = direct OpenAI embeddings API (needs OPENAI_API_KEY, 1536 dims for text-embedding-3-small)
# azure_openai = your Azure-hosted embedding deployment (needs AZURE_OPENAI_EMBEDDING_* below)
# IMPORTANT: EMBEDDING_DIM must match whichever model you pick above -
# changing embedding provider after documents are already indexed requires
# re-uploading them (the pgvector column has a fixed dimension).
EMBEDDING_PROVIDER=azure_openai
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- LLM ----------
# one of: openai | azure_openai | anthropic | gemini | ollama
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Azure OpenAI - chat model (only used when MODEL_PROVIDER=azure_openai) ----------
# Azure AI Foundry -> your resource -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# The DEPLOYMENT name you chose when deploying the model in Azure, not the
# base model name (e.g. "my-gpt5-mini" even if the underlying model is gpt-5-mini)
AZURE_OPENAI_DEPLOYMENT=

# ---------- Azure OpenAI - embeddings (only used when EMBEDDING_PROVIDER=azure_openai) ----------
# The DEPLOYMENT name you gave the embedding model in Azure (e.g. "my-embedding-3-small"),
# not the base model name like "text-embedding-3-small".
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Only set these two if the embedding model is deployed in a DIFFERENT Azure
# resource than your chat model. If it's the same resource, leave these
# blank and it will automatically reuse AZURE_OPENAI_ENDPOINT/AZURE_OPENAI_API_KEY above.
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_API_VERSION=

# ---------- RAG tuning ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE_SCORE=0.25

# ---------- Misc ----------
CORS_ORIGINS=*
